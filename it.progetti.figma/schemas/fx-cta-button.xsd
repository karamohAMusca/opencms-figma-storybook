<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:include schemaLocation="opencms://opencms-xmlcontent.xsd"/>

    <xsd:element name="FxCtaButtons" type="OpenCmsFxCtaButtons"/>

    <xsd:complexType name="OpenCmsFxCtaButtons">
        <xsd:sequence>
            <xsd:element name="FxCtaButton" type="OpenCmsFxCtaButton" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OpenCmsFxCtaButton">
        <xsd:sequence>
            <xsd:element name="Text" type="OpenCmsString"/>
            <xsd:element name="Link" type="OpenCmsVarLink"/>
        </xsd:sequence>
        <xsd:attribute name="language" type="OpenCmsLocale" use="required"/>
    </xsd:complexType>

    <xsd:annotation>
        <xsd:appinfo>
            <resourcebundles>
                <propertybundle name="it.progetti.figma.messages"/>
            </resourcebundles>
            <mappings>
                <mapping element="Text" mapto="property:Title"/>
            </mappings>
            <defaults>
                <default element="Text" value="Accedi"/>
            </defaults>
        </xsd:appinfo>
    </xsd:annotation>

</xsd:schema>
