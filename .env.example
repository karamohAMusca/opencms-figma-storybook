# Copia in .env (ignorato da git) e imposta i valori. Letto da dev.py e da docker compose (start.ps1).

# Account amministratore di OpenCms usato da dev.py (WebDAV e CmsShell).
OPENCMS_USER=Admin
OPENCMS_PASSWORD=

# Password root di MariaDB, condivisa da DB e OpenCms. Vale al primo avvio: il volume la conserva.
DB_PASSWORD=

# Chiave del file Figma (la parte dopo /design/ nell'URL). Facoltativa: senza, Storybook mostra solo gli screenshot salvati.
FIGMA_FILE_KEY=
